#version 450
layout(local_size_x = 1) in;

layout(push_constant) uniform Params {
    uint rec;
    uint task;
    uint room;
} pc;

layout(set = 0, binding = 0) buffer Rec { uint w[]; } rec;

void main() {
    if (pc.task != 0u) {
        uint asked = rec.w[pc.rec];
        rec.w[pc.rec + 13u] = asked;
        rec.w[pc.rec] = min(asked, pc.room);
    } else {
        uint m = min(rec.w[pc.rec + 4u], pc.room);
        rec.w[pc.rec + 4u] = m;
        rec.w[pc.rec + 9u] = m;
    }
}
