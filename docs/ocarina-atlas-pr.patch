+// The profile folder of a running NX2Saria (its saves are in profile/save/<account>/slot_XX): NX2SARIA_PROFILE_DIR in the
+// game's environment (relative to its executable's folder), else the profile folder beside its executable.
+function detectNx2SariaProfileDir() {
+  if (process.platform !== 'linux' || !fs.existsSync('/proc')) return null
+  let entries
+  try {
+    entries = fs.readdirSync('/proc', { withFileTypes: true })
+  } catch {
+    return null
+  }
+  for (const entry of entries) {
+    if (!entry.isDirectory() || !/^\d+$/.test(entry.name)) continue
+    try {
+      const comm = fs.readFileSync(`/proc/${entry.name}/comm`, 'utf8').trim().toLowerCase()
+      if (!NX2SARIA_PROCESS_NAMES.has(comm)) continue
+      const exeDir = path.dirname(fs.readlinkSync(`/proc/${entry.name}/exe`))
+      let profile = path.join(exeDir, 'profile')
+      for (const kv of fs.readFileSync(`/proc/${entry.name}/environ`, 'utf8').split('\0')) {
+        if (kv.startsWith('NX2SARIA_PROFILE_DIR=') && kv.length > 'NX2SARIA_PROFILE_DIR='.length) {
+          profile = path.resolve(exeDir, kv.slice('NX2SARIA_PROFILE_DIR='.length))
+        }
+      }
+      if (fs.existsSync(path.join(profile, 'save'))) return profile
+    } catch {
+      // Ignore exited/inaccessible process
+    }
+  }
+  return null
+}
